# SatyaSetu Backend Environment Configuration Template
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env to version control.
# NEVER put real keys in this file — it is committed to the repo.
#
# Quick-start checklist for a local demo (rows 1-4 and 8 from the API table):
#   1. GEMINI_API_KEY         → aistudio.google.com/apikey
#   2. GOOGLE_FACT_CHECK_API_KEY → console.cloud.google.com (Fact Check Tools API)
#   3. SEARCH_API_KEY         → app.tavily.com  (or api-dashboard.search.brave.com)
#   4. SENDER_HASH_SECRET     → generate with: python -c "import secrets; print(secrets.token_hex(32))"
#   5. ADMIN_API_KEY          → same command, run again for a fresh value
# Twilio (row 7) is only needed for the real WhatsApp path via ngrok.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# ── Gemini (Google AI Studio) ─────────────────────────────────────────────────
# Get key: https://aistudio.google.com/apikey
# Copy the exact model id shown in AI Studio into GEMINI_MODEL.
# Free tier: strict per-minute limits without billing. Adding billing raises them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Google Fact Check Tools API ───────────────────────────────────────────────
# Enable: console.cloud.google.com → API Library → "Fact Check Tools API"
# Create: APIs & Services → Credentials → API key (restrict to Fact Check Tools only)
# Do NOT use OAuth — claim search only needs the API key.
GOOGLE_FACT_CHECK_API_KEY=
FACTCHECK_MIN_MATCH=0.6

# ── Web Search Provider (one active at a time) ────────────────────────────────
# Tavily (recommended — 1,000 free credits/month, no card required)
#   Sign up: https://app.tavily.com  Keys start with tvly-
#   Note: your code uses "advanced" depth (~2 credits/search, ~4/claim).
#   ~250 claims/month on the free tier; caching repeat claims saves credits.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Brave Search alternative — uncomment these two and comment out the two above
# Needs a card even for the free monthly credit (~1,000 queries ≈ $5 credit)
#   Sign up: https://api-dashboard.search.brave.com/register
#   Key is sent as X-Subscription-Token header.
# SEARCH_PROVIDER=brave
# SEARCH_API_KEY=

# Keyless fallback (no account needed, lower result quality)
# SEARCH_PROVIDER=google_news_rss

# ── Local NLP / ML Models ─────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base
OCR_EXTRA_LANGS=hi,mr,ta,te,bn
NLI_MODEL_NAME=roberta-large-mnli
EMBEDDER_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ── Cache and Rate Limiting ───────────────────────────────────────────────────
CACHE_BACKEND=memory
RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_WINDOW=10
WEBHOOK_RATE_WINDOW_SECONDS=600.0
MAX_CLAIMS_PER_MESSAGE=3
RETRIEVAL_BUDGET_MS=12000

# ── Privacy and Security ──────────────────────────────────────────────────────
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
# Run the command TWICE to get two independent values.
SENDER_HASH_SECRET=replace_with_64_char_hex_from_secrets_token_hex_32
ADMIN_API_KEY=replace_with_64_char_hex_from_secrets_token_hex_32
CLAIMS_RETENTION_DAYS=30

# ── Twilio (only for real WhatsApp via ngrok) ─────────────────────────────────
# Create account: https://www.twilio.com/try-twilio
# Copy Account SID and Auth Token from the Twilio Console dashboard.
# Join the WhatsApp Sandbox (Messaging → Try it out → Send a WhatsApp message).
# Run: ngrok http 8000
# Set sandbox "When a message comes in" URL to: https://<ngrok-domain>/webhook/twilio
REQUIRE_TWILIO_SIGNATURE=false
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
PUBLIC_WEBHOOK_URL=https://your-ngrok-domain.ngrok-free.app

# ── Optional: Upstash Redis ───────────────────────────────────────────────────
# Only needed for multi-process / deployed environments.
# A single local process works fine with the default in-memory cache.
# Create: https://console.upstash.com  then set CACHE_BACKEND=redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
