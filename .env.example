# SatyaSetu Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# Do not commit your real .env file to version control.

# Server Settings
PORT=8000
ENV=development
LOG_LEVEL=INFO
PUBLIC_WEBHOOK_URL=https://your-ngrok-or-public-domain.ngrok-free.app

# Twilio Configuration
REQUIRE_TWILIO_SIGNATURE=false
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google and Gemini APIs
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# Web Search Provider (brave or tavily)
SEARCH_PROVIDER=brave
SEARCH_API_KEY=your_search_api_key_here

# Local NLP and ML Models
WHISPER_MODEL_SIZE=base
OCR_EXTRA_LANGS=hi
NLI_MODEL_NAME=roberta-large-mnli
EMBEDDER_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Cache and Rate Limiting
CACHE_BACKEND=memory
RATE_LIMIT_PER_MINUTE=20
MAX_CLAIMS_PER_MESSAGE=3
RETRIEVAL_BUDGET_MS=8000

# Optional Upstash Redis (used if CACHE_BACKEND=redis)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
