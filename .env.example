# SatyaSetu Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# ── Twilio Configuration ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── App & Server Settings ─────────────────────────────────────────────────
PORT=8000
FRONTEND_URL=http://localhost:3000
ENV=development

# ── Google & Gemini APIs ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# ── Bing Web Search API ───────────────────────────────────────────────────
BING_SEARCH_API_KEY=your_bing_search_api_key_here

# ── Redis (Upstash) Caching & Rate Limiting ──────────────────────────────
UPSTASH_REDIS_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./claims.db

# ── ML Model Configuration ────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base
